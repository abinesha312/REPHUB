# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resumerepo

# Storage Configuration
STORAGE_ROOT=./storage

# Embedding Model Configuration
# Default: sentence-transformers/all-MiniLM-L6-v2 (384 dimensions, local, no API key needed)
# Other options:
# - sentence-transformers/all-mpnet-base-v2 (768 dimensions, better quality)
# - sentence-transformers/paraphrase-MiniLM-L6-v2 (384 dimensions)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# API Configuration
API_PREFIX=/api

# CORS Origins (comma-separated for production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# DO NOT COMMIT SECRETS
# Add any API keys or sensitive configuration here
# kaggle.json and other credentials should NEVER be committed
